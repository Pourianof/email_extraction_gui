{
  "name": "ausmt-author-collector",
  "version": "1.3.0",
  "description": "An simple app to extract information of authors of the world's most prestigious publication",
  "main": "./src/backend/main.ts",
  "icon": "./assets/images/icons/icon.png",
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:dll": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./configs/webpack.config.renderer.dev.dll.ts",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./configs/webpack.config.renderer.prod.ts",
    "postinstall": "ts-node ./configs/scripts/check-native-dep.js && electron-builder install-app-deps && npm run build:dll",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
    "package": "ts-node ./configs/scripts/clean.js dist && npm run build && electron-builder build --publish never && npm run build:dll",
    "start": "ts-node ./configs/scripts/check-port-in-use.js && npm run start:renderer",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./configs/webpack.renderer.dev.config.ts",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./configs/webpack.preload.dev.config.ts",
    "start:main": "cross-env NODE_ENV=development NODE_OPTIONS=\"--import tsx\" electron ."
  },
  "author": {
    "name": "Pooria",
    "email": "PooriaXAmini@gmail.com",
    "url": "https://github.com/coded-by-pooria"
  },
  "license": "ISC",
  "devDependencies": {
    "@electron/notarize": "^2.3.2",
    "@electron/rebuild": "^3.6.0",
    "@faker-js/faker": "^8.4.1",
    "@sparticuz/chromium": "^119.0.2",
    "@types/command-line-args": "^5.2.3",
    "@types/ejs": "^3.1.5",
    "@types/node": "^18.13.0",
    "axios": "^1.6.7",
    "chrome-remote-interface": "^0.33.0",
    "cli-color": "^2.0.3",
    "command-line-args": "^5.2.1",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.1",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "detect-port": "^1.5.1",
    "ejs-webpack-loader": "^2.2.2",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.0",
    "electronmon": "^2.0.2",
    "eslint": "^9.5.0",
    "exceljs": "^4.4.0",
    "html-webpack-plugin": "^5.6.0",
    "https-proxy-agent": "^7.0.4",
    "mini-css-extract-plugin": "^2.9.0",
    "rimraf": "^6.0.1",
    "sass": "^1.77.6",
    "sass-loader": "^14.2.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "url-loader": "^4.1.1",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-manifest-plugin": "^5.0.0",
    "webpack-merge": "^5.10.0",
    "webpack-nano": "^1.1.1"
  },
  "dependencies": {
    "@pourianof/notifier": "^1.1.13",
    "chrowser_module": "https://github.com/Coded-By-Pooria/chrowser_module/tree/arch-rich-nav",
    "exceljs": "^4.4.0",
    "ghost-cursor": "^1.3.0",
    "https-proxy-agent": "^7.0.4",
    "i18next": "^26.3.0",
    "persian-number": "^1.6.0",
    "puppeteer-real-browser": "^1.4.1",
    "react-date-object": "^2.1.8",
    "winston": "^3.17.0"
  },
  "build": {
    "productName": "AUSMT author collector",
    "appId": "ac.ausmt.AuthorCollector",
    "copyright": "Copyright (C) 2024 Amol University of Special Modern Technologies",
    "buildVersion": "1.3.0",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json",
      "!temp"
    ],
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "./assets/images/icons/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/***/**/*"
    ]
  },
  "extraMetadata": {
    "version": "1.2.0"
  },
  "engines": {
    "node": ">=14.x",
    "npm": ">=7.x"
  }
}
