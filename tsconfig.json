{
  "ts-node": {
    "esm": true
  },
  "compilerOptions": {
    "incremental": true,
    "target": "es2021",
    "module": "commonjs",
    "lib": ["dom", "es2021", "es6", "es2016"],
    "strict": true,
    "sourceMap": true,
    "rootDir": "./src",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "configs/dll"
  },
  "files": ["./src/@types/global.d.ts"],
  "exclude": ["./test"]
}
