      </div>
      <div class="extracted-list-view"></div>
    </div>
  </div>

  <div id="extraction-hint hidden"></div>
  <form class="journal-form" name="journal-form">
    <div class="extract-btn-wrapper options-container">
      <div id="extraction-options">
        <div>
          <label for="only-main-author" class="btn">
            <input type="checkbox" id="only-main-author" name="only-main" />
            نویسنده اصلی مقاله
          </label>
        </div>
        <div>
          <label for="only-email" class="btn">
            <input id="only-email" type="checkbox" name="only-email" />
            نویسندگان دارای ایمیل
          </label>
        </div>
        <div>
          <label>اتمام جمع آوری پس از یافتن </label>
          <input
            dir="ltr"
            class="author-count"
            type="text"
            pattern="[\d]+"
            min="0"
            name="author-count"
            inputmode="numeric"
          />
          <label> نویسنده</label>
        </div>
        <div class="extractor-type">
          <label>استخراج کننده</label>
          <span
            id="what-is-extractor-type"
            data-name="extractor-type"
            data-mouse-move-sensitive
            class="what btn"
          ></span>
          <label>
            نوع <fa-num style="padding: 0 5px">1</fa-num>
            <span style="font-size: 0.8em">(chrowser)</span>
            <input checked type="radio" name="extractor-type" value="puppet" />
          </label>
          <label fa-num>
            نوع <fa-num style="padding: 0 5px"> 2 </fa-num>
            <span style="font-size: 0.8em">(puppet)</span>
            <input type="radio" name="extractor-type" value="chrowser" />
          </label>
        </div>
        <div class="extract-speed-opt">
          <label>سرعت استخراج</label>
          <span
            id="what-is-extract-speed"
            data-name="extract-speed"
            data-mouse-move-sensitive
            class="what btn"
          ></span>
          <select name="extract-speed">
            <option>حداکثر</option>
            <option>زیاد</option>
            <option>متوسط</option>
            <option>بهینه</option>
            <option selected>کم</option>
          </select>
        </div>
        <button class="btn reset-form rip-btn" type="reset">
          <svg
            id="Layer_1"
            data-name="Layer 1"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 17 20"
          >
            <defs>
              <style>
                .cls-1 {
                  fill-rule: evenodd;
                }
              </style>
            </defs>
            <path
              class="cls-1"
              d="M10.71.3a1,1,0,0,1,0,1.41L9.22,3.18H10a8.41,8.41,0,1,1-8.5,8.41,1,1,0,0,1,2,0A6.5,6.5,0,1,0,10,5.18H9.22L10.7,6.64A1,1,0,1,1,9.3,8.06L6.08,4.89a1,1,0,0,1-.29-.71,1,1,0,0,1,.29-.71L9.3.29A1,1,0,0,1,10.71.3Z"
              transform="translate(-1.5)"
            />
          </svg>
        </button>
      </div>
      <button id="extract-btn" class="hidden btn">شروع استخراج</button>
    </div>
    <div id="urls"></div>
  </form>
  <button id="add-new-url-btn" class="btn">افزودن آدرس نشریه جدید</button>
</div>
