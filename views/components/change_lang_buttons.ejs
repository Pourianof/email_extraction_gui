<div id="multi-lang-btns">
  <button
    id="language-toggle"
    class="language-toggle"
    type="button"
    aria-label="Change Language"
  >
    <span class="lang-option" data-lang="fa"> FA </span>

    <span class="lang-divider"></span>

    <span class="lang-option" data-lang="en"> EN </span>
  </button>
</div>
